# Settings read by shield-remote.service. All optional.
# Bind address; use 127.0.0.1 when a reverse proxy fronts it.
REMOTE_HOST=0.0.0.0
REMOTE_PORT=8780
# adb binary, if it isn't on PATH:
# ADB=/opt/platform-tools/adb
# Seed an Android TV device on first run (otherwise add devices from the page):
# SHIELD_IP=192.168.1.50
